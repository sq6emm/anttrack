# Copy this file to config.ini and fill in your own values.
# config.ini is gitignored so your home QTH coordinates and rotator's
# network address don't end up committed to version control.

[qth]
latitude = 51.618785667
longitude = 17.392723960
elevation_m = 208.558

[rotator]
# Hamlib rotator model number (see `rotctl --list`).
model = 2
host = 192.168.1.100
# Seconds to command the rotator ahead of real time, to compensate for
# its own slew lag. 0 disables lead compensation; tune upward from
# there if your dish/rotor is slow to slew relative to fast passes.
lead_time_s = 0.0
# Max allowed difference (degrees) between a previously commanded
# position and the rotator's actual read-back before it's flagged as a
# possible stall/backlash/fault. Set this to a fraction of your
# antenna's beamwidth.
error_threshold_deg = 0.3

# Optional: shows a live preview in the web UI. ffmpeg remuxes the RTSP
# feed (H.264 expected) into fragmented MP4 with no re-encoding, played
# natively by the browser's <video> tag. Delete this whole section (or
# leave rtsp_url blank) to disable it. Credentials go right in the URL,
# which is one more reason config.ini is gitignored rather than committed.
[camera]
rtsp_url = rtsp://user:password@192.168.1.50:554/h264Preview_01_sub
# All three below are optional and only make sense together: cropping
# to frame a fixed subject (e.g. an antenna) and scaling the result
# back up. Setting any of them switches from a cheap stream copy to an
# actual decode+re-encode, so also drop fps well below the source's own
# rate for anything that mostly doesn't move -- it's a big CPU saving
# for a subject like an antenna that isn't going to move in frame.
#
# crop: source-pixel box as width:height:x:y (top-left origin). Use
# ffprobe/ffplay on rtsp_url, or grab one frame with:
#   ffmpeg -rtsp_transport tcp -i <rtsp_url> -frames:v 1 out.jpg
# to see where your subject sits before picking numbers.
# crop = 210:190:20:80
#
# scale: output size as width:height, applied after the crop.
# scale = 640:580
#
# fps: output frame rate. Only relevant alongside crop/scale above.
# fps = 5
